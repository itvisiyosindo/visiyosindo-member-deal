# Portal Member Visi Academy & Link Manager - PT Visi Yosindo Medikal
Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pastikan default index adalah index.php (Portal Member)
    DirectoryIndex index.php

    # Jangan rewrite file atau folder fisik yang benar-benar ada
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Lindungi file tersembunyi
    RewriteRule ^\.(.*)$ - [F]

    # Jangan ubah rute asset statis
    RewriteRule ^css/ - [L]
    RewriteRule ^js/ - [L]

    # Rute khusus hidden Link Manager
    RewriteRule ^link-manager/?$ link-manager.php [L,QSA]
    RewriteRule ^links/?$ link-manager.php [L,QSA]
    RewriteRule ^tautan/?$ link-manager.php [L,QSA]

    # Pretty URL untuk halaman Member Portal
    RewriteRule ^login/?$ login.php [L,QSA]
    RewriteRule ^register/?$ register.php [L,QSA]
    RewriteRule ^dashboard/?$ dashboard.php [L,QSA]
    RewriteRule ^ajukan-deal/?$ ajukan-deal.php [L,QSA]
    RewriteRule ^tracking-deal/?$ tracking-deal.php [L,QSA]
    RewriteRule ^profil/?$ profil.php [L,QSA]
    RewriteRule ^logout/?$ logout.php [L,QSA]

    # Semua slug shortlink lainnya (contoh: /katalog, /GR-MEETING, /wa-admin, /PendaftaranPelatihan)
    # Alihkan ke mesin pengalihan redirect.html?go=slug
    RewriteRule ^([a-zA-Z0-9-_]+)/?$ redirect.html?go=$1 [L,QSA]
</IfModule>

# Keamanan header standar
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
